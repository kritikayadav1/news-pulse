# Local SQLite is automatic. Both Python and Node read this file.
PORT=3001
DB_PATH=data/news.db
# For a hosted PostgreSQL database, set the full connection string here.
# It takes precedence over DB_PATH. Use the provider's TLS-enabled URL.
DATABASE_URL=
# Optional absolute Python executable. npm run setup creates .venv automatically.
PYTHON_BIN=
CORS_ORIGIN=http://localhost:5173
AUTO_INGEST=false
INGEST_COOLDOWN_SECONDS=60
MAX_ARTICLES_PER_FEED=30
RETENTION_DAYS=30
REQUEST_TIMEOUT_SECONDS=25
ARTICLE_WORKERS=4
CLUSTER_SIMILARITY=0.25
CLUSTER_MIN_SHARED_WORDS=3
CLUSTER_WINDOW_HOURS=72
# Optional password to prevent arbitrary visitors from triggering collection.
# The frontend asks for this only when the server requires it; never use VITE_ for secrets.
INGEST_TOKEN=
